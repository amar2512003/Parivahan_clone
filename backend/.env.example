PORT=5001
JWT_SECRET=hackathon-dummy-secret-change-me
CORS_ORIGIN=http://localhost:5173

# Postgres connection string. For a hosted free-tier provider (Neon,
# Supabase, Vercel Postgres) paste the connection string they give you here
# - it's a drop-in replacement, nothing else in the code needs to change.
# Example (local Postgres running on this machine):
DATABASE_URL=postgresql://parivahan_user:parivahan_pass@localhost:5432/parivahan

# Optional override for whether the pg client uses SSL. Left unset, this
# is auto-detected: localhost/127.0.0.1 hosts -> no SSL, everything else
# (Neon/Supabase/Vercel Postgres etc.) -> SSL. Set to "true" or "false" to
# force it either way.
# DB_SSL=true

# Groq API key for the "Ask Me" traffic-light chatbot (backend/routes/chat.js).
# Get a free key at https://console.groq.com/keys — leave this blank and the
# chat widget will still render, it just shows a "not configured yet" notice
# instead of replying.
GROQ_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile if unset.
# GROQ_MODEL=llama-3.3-70b-versatile
